<mujoco model="moja_scena">
  <!-- 1. Dołączenie modelu robota / obiektu głównego -->
  <include file="g1_29dof.xml"/>
  <compiler angle="degree"/>

  <!-- 2. Ustawienia kamery i widoku -->
  <statistic center="0 0 0.5" extent="2.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="obstacle_mat" rgba="0.8 0.5 0.2 1"/>
    <material name="ramp_mat" rgba="0.2 0.6 0.8 1"/>

    <!-- Tekstury koloru (proceduralne) -->
    <texture name="tex_metal" type="2d" builtin="flat" width="1" height="1" rgb1="0.3 0.3 0.35"/>
    <texture name="tex_wood"  type="2d" builtin="flat" width="1" height="1" rgb1="0.75 0.6 0.45"/>

    <!-- Materiały powiązane z teksturami -->
    <material name="metal_frame" texture="tex_metal" shininess="0.3" specular="0.2"/>
    <material name="shelf_wood"  texture="tex_wood"  shininess="0.1" specular="0.1"/>

    <texture name="tex_table_top" type="2d" builtin="flat" width="1" height="1" rgb1="0.9 0.9 0.9"/>
    <texture name="tex_table_leg" type="2d" builtin="flat" width="1" height="1" rgb1="0.15 0.15 0.15"/>
    <texture name="tex_red"       type="2d" builtin="flat" width="1" height="1" rgb1="0.8 0.1 0.1"/>
    <texture name="tex_green"     type="2d" builtin="flat" width="1" height="1" rgb1="0.1 0.7 0.2"/>
    <texture name="tex_white"     type="2d" builtin="flat" width="1" height="1" rgb1="0.95 0.95 0.95"/>
    <texture name="tex_black"     type="2d" builtin="flat" width="1" height="1" rgb1="0.05 0.05 0.05"/>

    <material name="mat_table_top" texture="tex_table_top" shininess="0.1"/>
    <material name="mat_table_leg" texture="tex_table_leg" shininess="0.3"/>
    <material name="mat_red_zone"  texture="tex_red"/>
    <material name="mat_green_zone" texture="tex_green"/>
    <material name="mat_white_zone" texture="tex_white"/>
    <material name="mat_black_line" texture="tex_black"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.0" dir="0 0 -1" directional="true"/>

    <!-- Podłoga -->
    <geom name="floor" size="3.0 4.5 0.05" type="plane" material="groundplane"/>

    <body name="regal_1" pos="-1.3 0 0" euler="0 0 90">
      <geom type="box" size="0.02 0.02 0.9" pos="-0.88 -0.28 0.9" material="metal_frame"/>
      <geom type="box" size="0.02 0.02 0.9" pos=" 0.88 -0.28 0.9" material="metal_frame"/>
      <geom type="box" size="0.02 0.02 0.9" pos="-0.88  0.28 0.9" material="metal_frame"/>
      <geom type="box" size="0.02 0.02 0.9" pos=" 0.88  0.28 0.9" material="metal_frame"/>

      <geom type="box" size="0.88 0.28 0.015" pos="0 0 0.1" material="shelf_wood"/>
      <geom type="box" size="0.88 0.28 0.015" pos="0 0 0.5" material="shelf_wood"/>
      <geom type="box" size="0.88 0.28 0.015" pos="0 0 0.9" material="shelf_wood"/>
      <geom type="box" size="0.88 0.28 0.015" pos="0 0 1.3" material="shelf_wood"/>
      <geom type="box" size="0.88 0.28 0.015" pos="0 0 1.78" material="shelf_wood"/>
    </body>
    <body name="regal_2" pos="-1.3 1.8 0" euler="0 0 90">
      <geom type="box" size="0.02 0.02 0.9" pos="-0.88 -0.28 0.9" material="metal_frame"/>
      <geom type="box" size="0.02 0.02 0.9" pos=" 0.88 -0.28 0.9" material="metal_frame"/>
      <geom type="box" size="0.02 0.02 0.9" pos="-0.88  0.28 0.9" material="metal_frame"/>
      <geom type="box" size="0.02 0.02 0.9" pos=" 0.88  0.28 0.9" material="metal_frame"/>

      <geom type="box" size="0.88 0.28 0.015" pos="0 0 0.1" material="shelf_wood"/>
      <geom type="box" size="0.88 0.28 0.015" pos="0 0 0.5" material="shelf_wood"/>
      <geom type="box" size="0.88 0.28 0.015" pos="0 0 0.9" material="shelf_wood"/>
      <geom type="box" size="0.88 0.28 0.015" pos="0 0 1.3" material="shelf_wood"/>
      <geom type="box" size="0.88 0.28 0.015" pos="0 0 1.78" material="shelf_wood"/>
    </body>
    <body name="regal_3" pos="-1.3 -1.8 0" euler="0 0 90">
      <geom type="box" size="0.02 0.02 0.9" pos="-0.88 -0.28 0.9" material="metal_frame"/>
      <geom type="box" size="0.02 0.02 0.9" pos=" 0.88 -0.28 0.9" material="metal_frame"/>
      <geom type="box" size="0.02 0.02 0.9" pos="-0.88  0.28 0.9" material="metal_frame"/>
      <geom type="box" size="0.02 0.02 0.9" pos=" 0.88  0.28 0.9" material="metal_frame"/>

      <geom type="box" size="0.88 0.28 0.015" pos="0 0 0.1" material="shelf_wood"/>
      <geom type="box" size="0.88 0.28 0.015" pos="0 0 0.5" material="shelf_wood"/>
      <geom type="box" size="0.88 0.28 0.015" pos="0 0 0.9" material="shelf_wood"/>
      <geom type="box" size="0.88 0.28 0.015" pos="0 0 1.3" material="shelf_wood"/>
      <geom type="box" size="0.88 0.28 0.015" pos="0 0 1.78" material="shelf_wood"/>
    </body>

    
    <body name="regal_4" pos="1.3 1.8 0" euler="0 0 90">
      <geom type="box" size="0.02 0.02 0.9" pos="-0.88 -0.28 0.9" material="metal_frame"/>
      <geom type="box" size="0.02 0.02 0.9" pos=" 0.88 -0.28 0.9" material="metal_frame"/>
      <geom type="box" size="0.02 0.02 0.9" pos="-0.88  0.28 0.9" material="metal_frame"/>
      <geom type="box" size="0.02 0.02 0.9" pos=" 0.88  0.28 0.9" material="metal_frame"/>

      <geom type="box" size="0.88 0.28 0.015" pos="0 0 0.1" material="shelf_wood"/>
      <geom type="box" size="0.88 0.28 0.015" pos="0 0 0.5" material="shelf_wood"/>
      <geom type="box" size="0.88 0.28 0.015" pos="0 0 0.9" material="shelf_wood"/>
      <geom type="box" size="0.88 0.28 0.015" pos="0 0 1.3" material="shelf_wood"/>
      <geom type="box" size="0.88 0.28 0.015" pos="0 0 1.78" material="shelf_wood"/>
    </body>
    <body name="regal_5" pos="1.3 -1.8 0" euler="0 0 90">
      <geom type="box" size="0.02 0.02 0.9" pos="-0.88 -0.28 0.9" material="metal_frame"/>
      <geom type="box" size="0.02 0.02 0.9" pos=" 0.88 -0.28 0.9" material="metal_frame"/>
      <geom type="box" size="0.02 0.02 0.9" pos="-0.88  0.28 0.9" material="metal_frame"/>
      <geom type="box" size="0.02 0.02 0.9" pos=" 0.88  0.28 0.9" material="metal_frame"/>

      <geom type="box" size="0.88 0.28 0.015" pos="0 0 0.1" material="shelf_wood"/>
      <geom type="box" size="0.88 0.28 0.015" pos="0 0 0.5" material="shelf_wood"/>
      <geom type="box" size="0.88 0.28 0.015" pos="0 0 0.9" material="shelf_wood"/>
      <geom type="box" size="0.88 0.28 0.015" pos="0 0 1.3" material="shelf_wood"/>
      <geom type="box" size="0.88 0.28 0.015" pos="0 0 1.78" material="shelf_wood"/>
    </body>

    <body name="stol_etap1" pos="0 -4.1 0">
  
  <!-- Blat stołu (Wymiary: 180 cm x 80 cm, grubość 4 cm, środek blatu na Z = 0.70m, góra na Z = 0.72m) -->
  <geom name="blat" type="box" size="0.90 0.40 0.02" pos="0 0 0.70" material="mat_table_top"/>

  <!-- 4 Nogi stołu (Wysokość 68 cm, przekrój 4 cm x 4 cm) -->
  <geom type="box" size="0.02 0.02 0.34" pos="-0.86 -0.36 0.34" material="mat_table_leg"/>
  <geom type="box" size="0.02 0.02 0.34" pos=" 0.86 -0.36 0.34" material="mat_table_leg"/>
  <geom type="box" size="0.02 0.02 0.34" pos="-0.86  0.36 0.34" material="mat_table_leg"/>
  <geom type="box" size="0.02 0.02 0.34" pos=" 0.86  0.36 0.34" material="mat_table_leg"/>

  <!-- BANER / STREFY NA BLACIE (z minimalnym offsetem Z dla uniknięcia z-fightingu) -->

  <!-- Strefa Czerwona (Szerokość 80 cm, lewa strona) -->
  <geom name="strefa_czerwona" type="box" size="0.40 0.40 0.0005" pos="-0.50 0 0.7201" material="mat_red_zone"/>

  <!-- Strefa Zielona (Szerokość 80 cm, prawa strona) -->
  <geom name="strefa_zielona" type="box" size="0.40 0.40 0.0005" pos=" 0.50 0 0.7201" material="mat_green_zone"/>

  <!-- Biała strefa początkowa w środku (Szerokość 20 cm) -->
  <geom name="strefa_startowa" type="box" size="0.10 0.40 0.0006" pos="0 0 0.7202" material="mat_white_zone"/>

  <!-- 4 Miejsca na sześciany (kostki 5x5 cm z czarną linią obramowania o grubości 1 cm) -->
  <!-- Kostka 1 -->
  <geom type="box" size="0.035 0.035 0.0007" pos="0  0.105 0.7203" material="mat_black_line"/>
  <geom type="box" size="0.025 0.025 0.0008" pos="0  0.105 0.7204" material="mat_white_zone"/>

  <!-- Kostka 2 -->
  <geom type="box" size="0.035 0.035 0.0007" pos="0  0.035 0.7203" material="mat_black_line"/>
  <geom type="box" size="0.025 0.025 0.0008" pos="0  0.035 0.7204" material="mat_white_zone"/>

  <!-- Kostka 3 -->
  <geom type="box" size="0.035 0.035 0.0007" pos="0 -0.035 0.7203" material="mat_black_line"/>
  <geom type="box" size="0.025 0.025 0.0008" pos="0 -0.035 0.7204" material="mat_white_zone"/>

  <!-- Kostka 4 -->
  <geom type="box" size="0.035 0.035 0.0007" pos="0 -0.105 0.7203" material="mat_black_line"/>
  <geom type="box" size="0.025 0.025 0.0008" pos="0 -0.105 0.7204" material="mat_white_zone"/>

</body>

    
  </worldbody>
</mujoco>