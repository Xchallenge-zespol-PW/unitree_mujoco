    <texture name="tex_metal" type="2d" builtin="flat" width="1" height="1" rgb1="0.3 0.3 0.35"/>
    <texture name="tex_wood"  type="2d" builtin="flat" width="1" height="1" rgb1="0.75 0.6 0.45"/>
